        {"R7", "Pompa Air",               2,  75.0, 20.0, 0.15},
        {"R8", "Mesin Cuci",              2, 100.0,  2.0, 0.70}
    };

    cout << "\n=========================================================================================\n";
    cout << "   ANALISIS ALIRAN LISTRIK DINAMIS & RANGKAIAN PARALEL RUMAH (2.200 VA / 220V / 10A)\n";
    cout << "=========================================================================================\n";

    cout << "\n[A] GAMBAR SKEMA RANGKAIAN PARALEL INSTALASI RUMAH:\n";
    cout << "  [PLN 220V] --> [KWh 2200VA] --> [MCB Utama 10A] ===(I_tot = 9.81A)===> [SIMPUL UTAMA]\n";
    cout << "       ^                                                                       |\n";
    cout << "       | (Fasa 220V)   +---------------------------+---------------------------+\n";
    cout << "       |               |                           |                           |\n";
    cout << "       |        [Grup 1: AC]              [Grup 2: Tenaga]             [Grup 3: Lampu]\n";
    cout << "       |         (I_G1=5.99A)               (I_G2=2.27A)                 (I_G3=1.55A)\n";
    cout << "       |          +----+----+          +-----+--+--+-----+                +----+----+\n";
    cout << "       |          |         |          |     |     |     |                |         |\n";
    cout << "       |         [R1]      [R2]      [R3]  [R6]  [R7]  [R8]             [R4]      [R5]\n";
    cout << "       |        770W      350W      150W  100W   75W  100W             230W       60W\n";
    cout << "       |        62.9Ohm  138.3Ohm  322.7  484.0 645.3 484.0           210.4Ohm  806.7Ohm\n";
    cout << "       |          |         |          |     |     |     |                |         |\n";
    cout << "       +----------+---------+----------+-----+-----+-----+----------------+---------+\n";
    cout << "         (Netral 0V) <====================(Arus Kembali = 9.81A)=====================\n\n";

    cout << "[B] TABEL ALIRAN ARUS CABANG (HUKUM OHM) & HAMBATAN EKUIVALEN PARALEL:\n";
    cout << "+------+----------------------+---------+-----------+------------+------------+------------+\n";
    cout << "| Kode | Perangkat Listrik    | Daya(W) | I_Res(A)  | I_AC(PF.85)| Hambatan R | Impedansi Z|\n";
    cout << "+------+----------------------+---------+-----------+------------+------------+------------+\n";

    double totalDaya = 0.0, totalI_Res = 0.0, totalI_AC = 0.0;
    double invRTotal = 0.0, invZTotal = 0.0;
    double arusGrup[4] = {0.0, 0.0, 0.0, 0.0};
    double kwhMentahHarian = 0.0, kwhRealistisHarian = 0.0;

    for (int i = 0; i < 8; i++) {
        double P = daftarBeban[i].dayaWatt;
        double iRes = P / TEGANGAN_PLN;
        double iAC = P / (TEGANGAN_PLN * PF_RUMAH);
        double R_ek = (TEGANGAN_PLN * TEGANGAN_PLN) / P;
        double Z_ek = TEGANGAN_PLN / iAC;

        totalDaya += P;
        totalI_Res += iRes;
        totalI_AC += iAC;
        invRTotal += (1.0 / R_ek);
        invZTotal += (1.0 / Z_ek);
        arusGrup[daftarBeban[i].grupMCB] += iAC;

        kwhMentahHarian += (P * daftarBeban[i].jamNyala) / 1000.0;
        kwhRealistisHarian += (P * daftarBeban[i].jamNyala * daftarBeban[i].dutyCycle) / 1000.0;

        cout << "| " << left << setw(4) << daftarBeban[i].kode << " | "
             << left << setw(20) << daftarBeban[i].nama << right << " | "
             << setw(5) << fixed << setprecision(0) << P << " W | "
             << setw(7) << fixed << setprecision(3) << iRes << " A | "
             << setw(8) << fixed << setprecision(3) << iAC << " A | "
             << setw(7) << fixed << setprecision(2) << R_ek << " Ohm| "
             << setw(7) << fixed << setprecision(2) << Z_ek << " Ohm|\n";
    }

    double rTotalParalel = 1.0 / invRTotal;
    double zTotalParalel = 1.0 / invZTotal;

    cout << "+------+----------------------+---------+-----------+------------+------------+------------+\n";
    cout << "| TOT  | Total Paralel (220V) | "
         << setw(5) << fixed << setprecision(0) << totalDaya << " W | "
         << setw(7) << fixed << setprecision(3) << totalI_Res << " A | "
         << setw(8) << fixed << setprecision(3) << totalI_AC << " A | "
         << setw(7) << fixed << setprecision(2) << rTotalParalel << " Ohm| "
         << setw(7) << fixed << setprecision(2) << zTotalParalel << " Ohm|\n";
    cout << "+------+----------------------+---------+-----------+------------+------------+------------+\n";

    cout << "\n[C] VERIFIKASI HUKUM I KIRCHHOFF (KCL) & KAPASITAS MCB 10 AMPERE:\n";
    cout << "  * Arus Cabang Grup 1 (AC)         : " << fixed << setprecision(3) << arusGrup[1] << " A\n";
    cout << "  * Arus Cabang Grup 2 (Stopkontak) : " << arusGrup[2] << " A\n";
    cout << "  * Arus Cabang Grup 3 (Lampu/WiFi) : " << arusGrup[3] << " A\n";
    cout << "  * Total Arus Masuk = Arus Keluar  : " << totalI_AC << " A (Batas MCB = " << BATAS_ARUS_MCB << " A)\n";
    cout << "  * Sisa Margin Arus Aman           : " << (BATAS_ARUS_MCB - totalI_AC) << " A (Sangat Kritis / Rawan Trip!)\n";

    cout << "\n[D] RINGKASAN ENERGI DINAMIS (W = V.I.t) & BIAYA LISTRIK (Rp 1.444,70/kWh):\n";
    cout << "  * Energi Harian Realistis (Duty Cycle) : " << fixed << setprecision(2) << kwhRealistisHarian
         << " kWh/hari  -> Rp " << fixed << setprecision(0) << (kwhRealistisHarian * TARIF_PER_KWH) << " /hari\n";
    cout << "  * Biaya Bulanan Realistis (30 Hari)    : " << fixed << setprecision(1) << (kwhRealistisHarian * 30.0)
         << " kWh/bulan -> Rp " << fixed << setprecision(0) << (kwhRealistisHarian * 30.0 * TARIF_PER_KWH) << " /bulan\n";
    cout << "  * Biaya Bulanan Mentah 100% (30 Hari)  : " << fixed << setprecision(1) << (kwhMentahHarian * 30.0)
         << " kWh/bulan -> Rp " << fixed << setprecision(0) << (kwhMentahHarian * 30.0 * TARIF_PER_KWH) << " /bulan\n";
    cout << "=========================================================================================\n";
}

