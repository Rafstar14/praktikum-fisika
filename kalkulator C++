    const double TARIF_PER_KWH = 1444.70;

    BebanRumah daftarBeban[8] = {
        {"R1", "AC 1 PK (1 Unit)",        1, 770.0,  8.0, 0.70},
        {"R2", "AC 0.5 PK (1 Unit)",      1, 350.0,  8.0, 0.70},
