/**
 * Fungsi untuk mengubah nilai numerik Ohm menjadi string dengan satuan
 * yang sesuai (Ohm, kOhm, MOhm, atau GOhm).
 */
string formatOhm(double nilai) {
    ostringstream oss;
    oss << fixed << setprecision(3);
    if (nilai >= 1e9) {
        oss << (nilai / 1e9) << " GOhm";
    } else if (nilai >= 1e6) {
        oss << (nilai / 1e6) << " MOhm";
    } else if (nilai >= 1e3) {
        oss << (nilai / 1e3) << " kOhm";
    } else {
        oss << nilai << " Ohm";
    }
    return oss.str();
}

/**
 * Fungsi validasi input bilangan bulat (integer) dengan penanganan error
 * agar program tidak mengalami infinite loop saat pengguna memasukkan huruf.
 */
int inputIntValid(const string& prompt, int minVal, int maxVal) {
    int nilai;
    while (true) {
        cout << prompt;
        if (cin >> nilai && nilai >= minVal && nilai <= maxVal) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return nilai;
        }
        cout << "  [!] Input tidak valid. Masukkan bilangan bulat antara "
             << minVal << " sampai " << maxVal << ".\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

/**
 * Fungsi validasi input bilangan desimal (double) positif.
 */
double inputDoubleValid(const string& prompt, double minVal) {
    double nilai;
    while (true) {
        cout << prompt;
        if (cin >> nilai && nilai >= minVal) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return nilai;
        }
        cout << "  [!] Input tidak valid. Masukkan angka minimal " << minVal << ".\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

/**
 * Menampilkan tabel panduan kode warna di layar terminal.
 */
void tampilkanTabelReferensi(bool tampilTCR) {
    cout << "\n+------+----------+-------+---------------+-----------+-----------+\n";
    cout << "| Kode | Warna    | Digit | Pengali       | Toleransi | TCR(ppm)  |\n";
    cout << "+------+----------+-------+---------------+-----------+-----------+\n";
    for (int i = 0; i < 12; i++) {
        cout << "| " << setw(4) << TABEL_WARNA[i].kode << " | "
             << left << setw(8) << TABEL_WARNA[i].nama << right << " | ";

        if (TABEL_WARNA[i].digit != -1) {
            cout << setw(5) << TABEL_WARNA[i].digit << " | ";
        } else {
            cout << "    - | ";
        }

        cout << setw(13) << formatOhm(TABEL_WARNA[i].pengali) << " | ";

        if (TABEL_WARNA[i].toleransi > 0) {
            cout << setw(7) << fixed << setprecision(2) << TABEL_WARNA[i].toleransi << " % | ";
        } else {
            cout << "        - | ";
        }

        if (tampilTCR && TABEL_WARNA[i].tcr > 0) {
            cout << setw(9) << TABEL_WARNA[i].tcr << " |\n";
        } else {
            cout << "        - |\n";
        }
    }
    cout << "+------+----------+-------+---------------+-----------+-----------+\n";
}

/**
 * Meminta pengguna memilih kode warna yang memiliki nilai toleransi valid.
 */
int pilihWarnaToleransi() {
    while (true) {
        int idx = inputIntValid("Masukkan Kode Gelang Toleransi (1/2/5/6/7/8/10/11): ", 0, 11);
        if (TABEL_WARNA[idx].toleransi > 0) {
            return idx;
        }
        cout << "  [!] Warna " << TABEL_WARNA[idx].nama
             << " tidak memiliki spesifikasi nilai toleransi!\n";
    }
}

/**
 * Meminta pengguna memilih kode warna yang memiliki nilai TCR valid (Gelang 6).
 */
int pilihWarnaTCR() {
    while (true) {
        int idx = inputIntValid("Masukkan Kode Gelang 6 / Suhu TCR (0 s.d. 8)      : ", 0, 8);
        if (TABEL_WARNA[idx].tcr > 0) {
            return idx;
        }
        cout << "  [!] Warna tersebut tidak memiliki nilai koefisien suhu!\n";
    }
}

/**
 * MODUL 1: Menghitung Nilai Resistansi dari Urutan Warna (4, 5, dan 6 Gelang)
 */
void hitungWarnaKeOhm(int jumlahGelang) {
    cout << "\n===================================================================\n";
    cout << "          DEKODER RESISTOR " << jumlahGelang << " GELANG (WARNA -> OHM)\n";
    cout << "===================================================================\n";
    tampilkanTabelReferensi(jumlahGelang == 6);

    int g1 = inputIntValid("\nMasukkan Kode Gelang 1 (Digit Pertama, 1-9)       : ", 1, 9);
    int g2 = inputIntValid("Masukkan Kode Gelang 2 (Digit Kedua, 0-9)         : ", 0, 9);
    int g3 = 0, gPengali = 0, gToleransi = 0, gTCR = 0;

    double nilaiSignifikan = 0.0;

    if (jumlahGelang == 4) {
        gPengali = inputIntValid("Masukkan Kode Gelang 3 (Pengali, 0-11)            : ", 0, 11);
        gToleransi = pilihWarnaToleransi();
        nilaiSignifikan = (TABEL_WARNA[g1].digit * 10.0) + TABEL_WARNA[g2].digit;
    } else {
        g3 = inputIntValid("Masukkan Kode Gelang 3 (Digit Ketiga, 0-9)        : ", 0, 9);
        gPengali = inputIntValid("Masukkan Kode Gelang 4 (Pengali, 0-11)            : ", 0, 11);
        gToleransi = pilihWarnaToleransi();
        if (jumlahGelang == 6) {
            gTCR = pilihWarnaTCR();
        }
        nilaiSignifikan = (TABEL_WARNA[g1].digit * 100.0) +
                          (TABEL_WARNA[g2].digit * 10.0) +
                          TABEL_WARNA[g3].digit;
    }

    // Perhitungan nilai nominal dan batas toleransi
    double rNominal = nilaiSignifikan * TABEL_WARNA[gPengali].pengali;
    double tolPersen = TABEL_WARNA[gToleransi].toleransi;
    double simpanganMax = rNominal * (tolPersen / 100.0);
    double rMin = rNominal - simpanganMax;
    double rMax = rNominal + simpanganMax;

    cout << "\n-------------------------------------------------------------------\n";
    cout << " HASIL ANALISIS RESISTOR " << jumlahGelang << " GELANG\n";
    cout << "-------------------------------------------------------------------\n";
    cout << " Urutan Warna      : [" << TABEL_WARNA[g1].nama << "] - ["
         << TABEL_WARNA[g2].nama << "] - ";
    if (jumlahGelang >= 5) {
        cout << "[" << TABEL_WARNA[g3].nama << "] - ";
    }
    cout << "[" << TABEL_WARNA[gPengali].nama << "] - ["
         << TABEL_WARNA[gToleransi].nama << "]";
    if (jumlahGelang == 6) {
        cout << " - [" << TABEL_WARNA[gTCR].nama << "]";
    }
    cout << "\n";

    cout << " Nilai Nominal (R) : " << formatOhm(rNominal)
         << " (" << fixed << setprecision(2) << rNominal << " Ohm)\n";
    cout << " Toleransi         : +/- " << tolPersen << "% (+/- "
         << formatOhm(simpanganMax) << ")\n";
    cout << " Batas Minimum     : " << formatOhm(rMin) << "\n";
    cout << " Batas Maksimum    : " << formatOhm(rMax) << "\n";

    if (jumlahGelang == 6) {
        int tcrVal = TABEL_WARNA[gTCR].tcr;
        // Simulasi pergeseran resistansi jika suhu naik 50 derajat Celcius (dari 25C ke 75C)
        double deltaSuhu = 50.0;
        double deltaR_Suhu = rNominal * (static_cast<double>(tcrVal) / 1e6) * deltaSuhu;
        cout << " Koefisien Suhu    : " << tcrVal << " ppm/K\n";
        cout << " Efek Panas (+50C) : +/- " << formatOhm(deltaR_Suhu)
             << " (Rentang Suhu: " << formatOhm(rNominal - deltaR_Suhu)
             << " s.d. " << formatOhm(rNominal + deltaR_Suhu) << ")\n";
    }
    cout << "-------------------------------------------------------------------\n";
}

/**
 * MODUL 2: Mengonversi Nilai Resistansi (Ohm) menjadi Urutan Gelang Warna
 */
void hitungOhmKeWarna() {
    cout << "\n===================================================================\n";
    cout << "          ENKODER NILAI RESISTANSI KE WARNA (4 & 5 GELANG)\n";
    cout << "===================================================================\n";

    double rInput = inputDoubleValid("Masukkan Nilai Resistansi dalam Ohm (contoh 0.22 atau 4700): ", 0.1);

    // 1. Konversi ke 4 Gelang (2 Digit Signifikan)
    int pangkat4 = static_cast<int>(floor(log10(rInput))) - 1;
    double norm4 = rInput / pow(10.0, pangkat4);
    int duaDigit = static_cast<int>(round(norm4));

    if (duaDigit >= 100) {
        duaDigit /= 10;
        pangkat4 += 1;
    }

    int d1_4 = duaDigit / 10;
    int d2_4 = duaDigit % 10;
    int idxPengali4 = -1;
    if (pangkat4 == -2) idxPengali4 = 11;      // Perak (0.01)
    else if (pangkat4 == -1) idxPengali4 = 10; // Emas (0.1)
    else if (pangkat4 >= 0 && pangkat4 <= 9) idxPengali4 = pangkat4;

    // 2. Konversi ke 5 Gelang (3 Digit Signifikan)
    int pangkat5 = static_cast<int>(floor(log10(rInput))) - 2;
    double norm5 = rInput / pow(10.0, pangkat5);
    int tigaDigit = static_cast<int>(round(norm5));

    if (tigaDigit >= 1000) {
        tigaDigit /= 10;
        pangkat5 += 1;
    }

    int d1_5 = tigaDigit / 100;
    int d2_5 = (tigaDigit / 10) % 10;
    int d3_5 = tigaDigit % 10;
    int idxPengali5 = -1;
    if (pangkat5 == -2) idxPengali5 = 11;
    else if (pangkat5 == -1) idxPengali5 = 10;
    else if (pangkat5 >= 0 && pangkat5 <= 9) idxPengali5 = pangkat5;

    cout << "\n-------------------------------------------------------------------\n";
    cout << " HASIL KONVERSI WARNA GELANG\n";
    cout << "-------------------------------------------------------------------\n";
    cout << " Nilai Input       : " << formatOhm(rInput) << "\n\n";

    if (idxPengali4 != -1) {
        double rHasil4 = (d1_4 * 10.0 + d2_4) * TABEL_WARNA[idxPengali4].pengali;
        cout << " [A] Versi 4 Gelang (Standar Toleransi Emas +/- 5%):\n";
        cout << "     Nilai Terdekat: " << formatOhm(rHasil4) << "\n";
        cout << "     Urutan Warna  : [" << TABEL_WARNA[d1_4].nama << "] - ["
             << TABEL_WARNA[d2_4].nama << "] - ["
             << TABEL_WARNA[idxPengali4].nama << "] - [Emas]\n\n";
    } else {
        cout << " [A] Versi 4 Gelang: Nilai di luar jangkauan pengali 4 gelang.\n\n";
    }

    if (idxPengali5 != -1) {
        double rHasil5 = (d1_5 * 100.0 + d2_5 * 10.0 + d3_5) * TABEL_WARNA[idxPengali5].pengali;
        cout << " [B] Versi 5 Gelang (Presisi Toleransi Cokelat +/- 1%):\n";
        cout << "     Nilai Terdekat: " << formatOhm(rHasil5) << "\n";
        cout << "     Urutan Warna  : [" << TABEL_WARNA[d1_5].nama << "] - ["
             << TABEL_WARNA[d2_5].nama << "] - ["
             << TABEL_WARNA[d3_5].nama << "] - ["
             << TABEL_WARNA[idxPengali5].nama << "] - [Cokelat]\n";
    } else {
        cout << " [B] Versi 5 Gelang: Nilai di luar jangkauan pengali 5 gelang.\n";
    }
    cout << "-------------------------------------------------------------------\n";
}

/**
 * MODUL 3: Dekoder Resistor SMD (Surface Mount Device)
 * Mendukung sistem 3-Digit (contoh: 472), 4-Digit (contoh: 1002),
 * dan notasi desimal 'R' (contoh: 4R7, R22, 0R5).
 */
void hitungKodeSMD() {
    cout << "\n===================================================================\n";
    cout << "             DEKODER KODE RESISTOR SMD (3/4 DIGIT & R)\n";
    cout << "===================================================================\n";
    cout << " Contoh Kode Valid: 103 (10 kOhm), 4702 (47 kOhm), 4R7 (4.7 Ohm), R22 (0.22 Ohm)\n";
    cout << " Masukkan Kode Tertulis pada Bodi SMD: ";

    string kode;
    cin >> kode;
    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    // Ubah seluruh karakter ke huruf kapital
    for (size_t i = 0; i < kode.length(); i++) {
        kode[i] = static_cast<char>(toupper(static_cast<unsigned char>(kode[i])));
    }

    try {
        double rSMD = 0.0;
        size_t posR = kode.find('R');

        if (posR != string::npos) {
            // Jika menggunakan huruf 'R' sebagai penanda titik desimal
            string gantiTitik = kode;
            gantiTitik[posR] = '.';
            if (posR == 0) {
                gantiTitik = "0" + gantiTitik;
            }
            size_t idxTerbaca = 0;
            rSMD = stod(gantiTitik, &idxTerbaca);
            if (idxTerbaca != gantiTitik.length()) {
                throw invalid_argument("Format karakter R tidak valid.");
            }
        } else if (kode.length() == 3 || kode.length() == 4) {
            // Pastikan seluruh karakter adalah angka
            for (size_t i = 0; i < kode.length(); i++) {
                if (!isdigit(static_cast<unsigned char>(kode[i]))) {
                    throw invalid_argument("Kode harus berupa angka atau notasi R.");
                }
            }
            int panjangSig = static_cast<int>(kode.length()) - 1;
            double angkaSig = stod(kode.substr(0, panjangSig));
            int pangkat = kode[panjangSig] - '0';
            rSMD = angkaSig * pow(10.0, pangkat);
        } else {
            throw invalid_argument("Panjang kode SMD harus 3 atau 4 karakter.");
        }

        cout << "\n-------------------------------------------------------------------\n";
        cout << " Kode SMD          : " << kode << "\n";
        cout << " Nilai Resistansi  : " << formatOhm(rSMD)
             << " (" << fixed << setprecision(3) << rSMD << " Ohm)\n";
        cout << "-------------------------------------------------------------------\n";
    } catch (const exception& e) {
        cout << "\n  [!] Gagal membaca kode SMD: " << e.what() << "\n";
    }
}

/**
 * Menentukan ukuran fisik daya resistor (Watt) yang aman digunakan.
 * Menggunakan faktor keamanan (derating factor) 2x lipat dari disipasi daya aktual
 * agar komponen tidak mengalami panas berlebih (overheat).
 */
string rekomendasiWattResistor(double dayaAktual) {
    double dayaAman = dayaAktual * 2.0;
    if (dayaAman <= 0.125) return "1/8 W (0.125 W)";
    if (dayaAman <= 0.25)  return "1/4 W (0.25 W)";
    if (dayaAman <= 0.5)   return "1/2 W (0.50 W)";
    if (dayaAman <= 1.0)   return "1 W";
    if (dayaAman <= 2.0)   return "2 W";
    if (dayaAman <= 5.0)   return "5 W (Resistor Kapur)";
    return "> 5 W (Wajib Heatsink/Wirewound!)";
}

/**
 * MODUL 4: Kalkulator Rangkaian Seri/Paralel, Hukum Ohm, dan Disipasi Daya
 */
void hitungRangkaianDanDaya() {
    cout << "\n===================================================================\n";
    cout << "     KALKULATOR RANGKAIAN SERI / PARALEL & ANALISIS DAYA (WATT)\n";
    cout << "===================================================================\n";
    cout << " [1] Rangkaian Seri   (Arus sama, Tegangan terbagi)\n";
    cout << " [2] Rangkaian Paralel (Tegangan sama, Arus terbagi)\n";
    int mode = inputIntValid("Pilih Konfigurasi Rangkaian (1/2): ", 1, 2);

    int n = inputIntValid("Masukkan Jumlah Komponen Resistor (2 s.d. 20 unit): ", 2, 20);
    double R[20];

    for (int i = 0; i < n; i++) {
        string prompt = "  Masukkan Nilai R" + to_string(i + 1) + " dalam Ohm: ";
        R[i] = inputDoubleValid(prompt, 0.01);
    }

    double vSumber = inputDoubleValid("Masukkan Tegangan Sumber DC dalam Volt (0 jika tanpa sumber): ", 0.0);

    double rTotal = 0.0;
    if (mode == 1) {
        for (int i = 0; i < n; i++) {
            rTotal += R[i];
        }
    } else {
        double konduktansiTotal = 0.0;
        for (int i = 0; i < n; i++) {
            konduktansiTotal += (1.0 / R[i]);
        }
        rTotal = 1.0 / konduktansiTotal;
    }

    cout << "\n-------------------------------------------------------------------\n";
    cout << " HASIL ANALISIS RANGKAIAN " << (mode == 1 ? "SERI" : "PARALEL") << "\n";
    cout << "-------------------------------------------------------------------\n";
    cout << " Resistansi Total (R_ekivalen)  : " << formatOhm(rTotal)
         << " (" << fixed << setprecision(4) << rTotal << " Ohm)\n";

    if (vSumber > 0.0) {
        double iTotal = vSumber / rTotal;
        double pTotal = vSumber * iTotal;

        cout << " Tegangan Sumber (V_sumber)     : " << fixed << setprecision(2) << vSumber << " Volt\n";
        cout << " Arus Total Rangkaian (I_total) : " << fixed << setprecision(4)
             << (iTotal * 1000.0) << " mA (" << iTotal << " A)\n";
        cout << " Disipasi Daya Total (P_total)  : " << fixed << setprecision(4) << pTotal << " Watt\n\n";

        cout << "+------+---------------+------------+------------+------------+-----------------------+\n";
        cout << "| Komp | Resistansi    | Tegangan   | Arus (mA)  | Daya (W)   | Rekomendasi Rating    |\n";
        cout << "+------+---------------+------------+------------+------------+-----------------------+\n";

        for (int i = 0; i < n; i++) {
            double vKomp = (mode == 1) ? (iTotal * R[i]) : vSumber;
            double iKomp = vKomp / R[i];
            double pKomp = vKomp * iKomp;

            cout << "| R" << left << setw(3) << (i + 1) << right << " | "
                 << setw(13) << formatOhm(R[i]) << " | "
                 << setw(8) << fixed << setprecision(2) << vKomp << " V | "
                 << setw(8) << fixed << setprecision(2) << (iKomp * 1000.0) << " | "
                 << setw(8) << fixed << setprecision(4) << pKomp << " | "
                 << left << setw(21) << rekomendasiWattResistor(pKomp) << right << " |\n";
        }
        cout << "+------+---------------+------------+------------+------------+-----------------------+\n";
        cout << " *Catatan: Rekomendasi rating daya menggunakan faktor keamanan 2x daya disipasi.\n";
    }
}

/**
 * MODUL 5: Analisis Aliran Kelistrikan Dinamis & Skema Rangkaian Rumah (2.200 VA)
 * Menghitung arus cabang (Hukum Ohm), pembuktian Hukum I Kirchhoff (KCL),
 * hambatan pengganti paralel rumah, energi harian/bulanan, serta mencetak skema.
 */
