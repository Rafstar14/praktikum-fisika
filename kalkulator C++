/**
 * Struktur data untuk menyimpan parameter tiap warna gelang resistor
 * berdasarkan standar internasional IEC 60062 / EIA.
 */
struct WarnaResistor {
    int kode;           // Nomor indeks input pengguna (0 - 11)
    string nama;        // Nama warna gelang
    int digit;          // Nilai angka signifikan (0 - 9), -1 jika tidak berlaku
    double pengali;     // Faktor pengali desimal (0.01 hingga 10^9)
    double toleransi;   // Persentase toleransi (%), -1.0 jika tidak berlaku
    int tcr;            // Koefisien suhu dalam ppm/K (Gelang ke-6), -1 jika tidak berlaku
};

